[gd_scene format=3]

[ext_resource type="Script" path="res://title/Title.cs" id="1"]

[node name="Title" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.04, 0.045, 0.07, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Rows" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Name" type="Label" parent="Center/Rows"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.75, 0.3, 1)
theme_override_font_sizes/font_size = 72
text = "TOUCHDOWN"
horizontal_alignment = 1

[node name="Pitch" type="Label" parent="Center/Rows"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Land the ship from inside it.
The two thruster levers are at opposite ends of the cabin."
horizontal_alignment = 1

[node name="Controls" type="Label" parent="Center/Rows"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.72, 0.78, 1)
text = "A / D  walk      Space  jump      W / S  push a lever up or down (stand at it)
R  restart      Esc  back"
horizontal_alignment = 1

[node name="Start" type="Label" parent="Center/Rows"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Press Space"
horizontal_alignment = 1
