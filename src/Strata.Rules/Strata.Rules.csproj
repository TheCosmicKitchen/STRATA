<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Strata.Sim\Strata.Sim.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The simulation is the hot path: optimise even in Debug, or the game cannot keep up. -->
